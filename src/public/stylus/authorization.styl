@import 'index'

.auth-wrapper
  width 90%
  max-width 500px
  margin 120px auto 60px
  background #fff
  border-radius 12px
  box-shadow 0 2px 10px rgba(0,0,0,.08)
  padding 40px 30px
  font-family fontRegular

  @media (max-width: 768px)
    margin-top 100px
    padding 30px 20px

.auth-title
  font-size 1.8rem
  color #7a1b1b
  margin-bottom 25px
  text-align center

.auth-toggle
  btn()
  width 100%
  margin-top 15px