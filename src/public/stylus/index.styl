whiteColor = #fff
darkRed = #800000
footerBg = #2f0909
borderGray = #7E868E

fontRegular = "bergamosco-regular", sans-serif

radiusBtn = 20px
transitionFast = 0.3s

bp-mobile = 480px
bp-tablet = 768px
bp-laptop = 1200px
bp-tv = 1920px

flex(justify = center, align = center, direction = row)
  display flex
  flex-direction direction
  justify-content justify
  align-items align

text(size = 16px, color = whiteColor, font = fontRegular)
  font-size size
  color color
  font-family font

abs(top = auto, left = auto)
  position absolute
  top top
  left left

btn(bg = darkRed)
  background-color bg
  color whiteColor
  border none
  border-radius radiusBtn
  cursor pointer
  transition all transitionFast

  &:hover
    opacity .8

media(max = null, min = null)
  if max && min
    @media (min-width: min) and (max-width: max)
      {block}
  else if max
    @media (max-width: max)
      {block}
  else if min
    @media (min-width: min)
      {block}

*
  margin 0
  padding 0
  box-sizing border-box
  font-family fontRegular

body
  font-family fontRegular
  background-color whiteColor

.header_main
  flex(space-between)
  width 100%
  height 100px
  padding 0 1%
  background-color darkRed
  border-bottom 1px solid borderGray
  color whiteColor
  position fixed
  top 0
  left 0
  z-index 100

  .logo
    height 100%
    flex()
    img
      max-height 80px
      padding 5px
      object-fit contain
      transition all transitionFast

  .wineshop
    text(50px, whiteColor, fontRegular)
    line-height 1

  .contacts
    flex()
    gap 20px
    height 100%
    a
      display flex
      align-items center
      justify-content center
      width 60px
      height 60px
      
    img
      width 100%
      height 100%
      object-fit contain
      transition all transitionFast
    .profile
      transform scale(1.1)
    .cart
      transform scale(1.3)
    .admin
      transform scale(1.1)

  media(max = bp-tablet)
    height 70px
    padding 0 10px
    .logo img
      max-height 50px
    .wineshop
      font-size 26px
    .contacts
      gap 14px
      .profile,
      .cart,
      .admin
        width 40px
        height 40px

  media(max = bp-mobile)
    height 60px
    .logo img
      max-height 40px
    .wineshop
      font-size 20px
    .contacts
      gap 10px
      .profile,
      .cart,
      .admin
        width 32px
        height 32px

.body_main
  padding-top 100px

  media(max = bp-tablet)
    padding-top 70px
  media(max = bp-mobile)
    padding-top 60px

.background-container
  width 100%
  position relative

.bg-1,
.bg-2
  width 100%
  height 100vh
  background-size cover
  background-position center
  background-repeat no-repeat
  position relative
  flex()
  justify-content center
  align-items center

.bg-1
  background-image url('/api/public/file/?name=imgs/bg.webp')

.bg-2
  background-image url('/api/public/file/?name=imgs/slider.webp')

.vinishko
  abs(25%, 12%)
  font-family fontRegular
  color whiteColor
  font-size clamp(22px, 5vw, 50px)
  z-index 20

.butcat
  abs(50%, 12%)
  btn()
  font-size clamp(14px, 2.5vw, 18px)
  padding clamp(10px, 2vw, 15px) clamp(18px, 4vw, 30px)
  z-index 5


.slider
  width clamp(280px, 80vw, 500px)
  height clamp(360px, 80vh, 650px)
  position relative
  overflow hidden
  margin 10vh auto


  media(max = bp-laptop)
    max-width 700px
  media(max = bp-tablet)
    max-width 500px
    width 90%
  media(max = bp-mobile)
    width 100%
    max-width 400px
    min-height 250px

.slider-img
  width 100%
  height 100%
  position absolute
  top 0
  left 0
  opacity 0
  transition opacity 0.5s ease

.slider-img.active
  opacity 1

.slider .left_controlls,
.slider .right_controlls
  position absolute
  top 50%
  transform translateY(-50%)
  height 800px
  width 60px
  cursor pointer
  z-index 10

.slider .left_controlls
  left 10px
  opacity 0

.slider .right_controlls
  right 10px
  opacity 0

.acii
  width 100%
  height auto

.acii img
  width 100%
  height auto
  object-fit contain

.footer
  background-color footerBg
  color whiteColor
  flex(space-between)
  padding 20px 60px
  height 250px
  font-family fontRegular
  margin-top auto
  media(max = bp-tablet)
    flex(direction column, align flex-start)
    height auto
    gap 20px
    padding 20px
  media(max = bp-mobile)
    align-items center
    text-align center
