whiteColor = #fff
darkRed = #800000
footerBg = #2f0909
borderGray = #7E868E

fontRegular = "bergamosco-regular", sans-serif
fontLight = "bergamosco-light", sans-serif

radiusBtn = 20px
transitionFast = 0.3s

bp-mobile = 480px
bp-tablet = 768px
bp-laptop = 1200px
bp-tv = 1920px

flex(justify = center, align = center, direction = row)
  display flex
  flex-direction direction
  justify-content justify
  align-items align

text(size = 16px, color = whiteColor, font = fontRegular)
  font-size size
  color color
  font-family font

abs(top = auto, left = auto)
  position absolute
  top top
  left left

fixed(top = auto, left = auto)
  position fixed
  top top
  left left

btn(bg = darkRed)
  background-color bg
  color whiteColor
  border none
  border-radius radiusBtn
  cursor pointer
  transition all transitionFast
  &:hover
    opacity .8

media(max = null, min = null)
  if max && min
    @media (min-width: min) and (max-width: max)
      {block}
  else if max
    @media (max-width: max)
      {block}
  else if min
    @media (min-width: min)
      {block}

*
  margin 0
  padding 0
  box-sizing border-box

body
  background-color whiteColor

.header_main
  display flex
  align-items center
  justify-content space-between

  width 100vw
  height 100px
  padding 0 1%
  background-color darkRed
  border-bottom 1px solid borderGray
  color whiteColor
  fixed(0, 0)
  z-index 100

  .logo
    height 100%
    display flex
    align-items center

    img
      height 80%
      width auto
      max-height 80px
      padding 5px

  .wineshop
    text(50px, whiteColor, fontLight)
    line-height 1

  .user-icons
    display flex
    align-items center
    gap 20px
    height 100%

    img
      height 60%
      width auto
      max-height 60px

      &.admin
        max-height 60px

  media(max: bp-tablet)
    height 70px
    padding 0 10px

    .logo img
      max-height 50px

    .user-icons img
      max-height 40px

    .wineshop
      font-size 26px

  media(max: bp-mobile)
    height 60px

    .logo img
      max-height 40px

    .user-icons img
      max-height 32px

    .wineshop
      font-size 20px

.background-container
  width 100vw
  position relative

.bg-1,
.bg-2
  width 100vw
  height 100vh
  background-size cover
  background-position center
  background-repeat no-repeat
  position relative

  media(max: bp-tablet)
    height 80vh

  media(max: bp-mobile)
    min-height 400px
    height auto

.bg-1
  background-image url('../../assets/bg.webp')

.bg-2
  background-image url('../../assets/slider.webp')
  flex()

.acii
  width 100%
  height 100%
  flex()
  overflow hidden

.vinishko
  abs(200px, 12%)
  text(50px)
  z-index 20

  media(max: bp-tablet)
    font-size 36px
    top 150px

  media(max: bp-mobile)
    position static
    font-size 26px
    text-align center
    margin 20px auto

.ssilka
  position absolute
  top 80%
  right 10%
  color darkRed

.butcat
  abs(60%, 12%)
  btn()
  padding 15px 30px
  font-family fontRegular
  z-index 5

  media(max: bp-mobile)
    position static
    margin 20px auto
    display block

.slider
  width 450px
  height 550px
  position relative
  overflow hidden
  z-index 10

  media(max: bp-laptop)
    width 360px
    height 460px

  media(max: bp-tablet)
    width 280px
    height 360px

  media(max: bp-mobile)
    width 100%
    height 300px

  &-img
    position absolute
    inset 0
    opacity 0
    transition opacity .5s

    &.active
      opacity 1

  img
    width 100%
    height 100%
    object-fit cover

.footer
  background-color footerBg
  text()
  flex(space-between)
  padding 20px 60px
  height 250px

  media(max: bp-tablet)
    flex(column, flex-start)
    height auto
    gap 20px
    padding 20px

  media(max: bp-mobile)
    text-align center

    .menu_foot
      flex(column)
      gap 10px

media(min: bp-tv)
  body
    font-size 20px

  .wineshop
    font-size 64px

  .header_main
    height 130px

    .logo img
      max-height 100px

    .user-icons img
      max-height 80px

  .slider
    width 600px
    height 750px

  .footer
    padding 40px 120px
