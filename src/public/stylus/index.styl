whiteColor = #fff
darkRed = #800000
footerBg = #2f0909
borderGray = #7E868E

fontRegular = "bergamosco-regular", sans-serif

radiusBtn = 20px
transitionFast = 0.3s

bp-mobile = 480px
bp-tablet = 768px
bp-laptop = 1200px
bp-tv = 1920px

flex(justify = center, align = center, direction = row)
  display flex
  flex-direction direction
  justify-content justify
  align-items align

text(size = 16px, color = whiteColor, font = fontRegular)
  font-size size
  color color
  font-family font

abs(top = auto, left = auto)
  position absolute
  top top
  left left

fixed(top = auto, left = auto)
  position fixed
  top top
  left left

btn(bg = darkRed)
  background-color bg
  color whiteColor
  border none
  border-radius radiusBtn
  cursor pointer
  transition all transitionFast

  &:hover
    opacity .8

media(max = null, min = null)
  if max && min
    @media (min-width: min) and (max-width: max)
      {block}
  else if max
    @media (max-width: max)
      {block}
  else if min
    @media (min-width: min)
      {block}

*
  margin 0
  padding 0
  box-sizing border-box

.body_main
  background-color whiteColor !important
  padding-top 100px

  media(max = bp-tablet)
    padding-top 70px

  media(max = bp-mobile)
    padding-top 60px

.header_main
  flex(space-between)
  width 100%
  height 100px
  padding 0 1%
  background-color darkRed
  border-bottom 1px solid borderGray
  color whiteColor
  fixed(0, 0)
  z-index 100

  .logo
    height 100%
    flex()

    img
      max-height 80px
      padding 5px

  .wineshop
    text(50px, whiteColor, fontRegular)
    line-height 1

  .contacts
    flex()
    gap 20px
    height 100%

    .profile,
    .cart,
    .admin
      width 100px
      height 100px
      object-fit contain
      transition all transitionFast

  media(max = bp-tablet)
    height 70px
    padding 0 10px

    .logo img
      max-height 50px

    .wineshop
      font-size 26px

    .contacts
      gap 14px

      .profile,
      .cart,
      .admin
        width 40px
        height 40px

  media(max = bp-mobile)
    height 60px

    .logo img
      max-height 40px

    .wineshop
      font-size 20px

    .contacts
      gap 10px

      .profile,
      .cart,
      .admin
        width 32px
        height 32px

.background-container
  width 100%
  position relative

.header_main a,
.footer a
  color whiteColor
  text-decoration none

  &:hover
    opacity .8

.bg-1,
.bg-2
  width 100%
  height 100vh
  background-size cover
  background-position center
  background-repeat no-repeat
  position relative

  media(max = bp-tablet)
    height 80vh

  media(max = bp-mobile)
    min-height 400px
    height auto
    flex(direction = column)
    justify-content center
    text-align center

.bg-1
  background-image url('/api/public/file/?name=imgs/bg.webp')

.bg-2
  background-image url('/api/public/file/?name=imgs/slider.webp')
  flex()

.acii
  width 100%
  height 100%
  flex()
  overflow hidden

.acii img
  width 100%
  height 100%
  object-fit cover

.vinishko
  abs(300px, 12%)
  text(50px, whiteColor, fontRegular)
  z-index 20

  media(max = bp-tablet)
    font-size 36px
    top 150px

  media(max = bp-mobile)
    position absolute
    top 50px
    left 50%
    transform translateX(-50%)
    font-size 26px
    margin 0

.ssilka
  abs(80%, auto)
  right 10%
  color darkRed

.butcat
  abs(60%, 12%)
  btn()
  padding 15px 30px
  font-family fontRegular
  z-index 5

  media(max = bp-mobile)
    position static
    margin 20px auto
    padding 18px 36px
    font-size 16px
    display block

.slider
  position relative
  overflow hidden
  z-index 10

  .left_controlls,
  .right_controlls
    width 40px

  media(max = bp-laptop)
    width 360px
    height 460px

  media(max = bp-tablet)
    width 280px
    height 360px

  media(max = bp-mobile)
    width 100%
    height 300px

  &-img
    position absolute
    inset 0
    opacity 0
    transition opacity .5s

    &.active
      opacity 1

  img
    width 100%
    height 100%
    object-fit cover

.footer
  background-color footerBg
  text()
  flex(space-between)
  padding 20px 60px
  height 250px
  font-family fontRegular

  media(max = bp-tablet)
    flex(direction = column, align = flex-start)
    height auto
    gap 20px
    padding 20px

  media(max = bp-mobile)
    align-items center
    text-align center

    .menu_foot
      flex(direction = column)
      gap 10px
