@import 'index'

body
  font-family fontRegular
  color blackColor
  background bgMain

.profile-edit-form
  margin-bottom 30px
  padding 20px
  background whiteColor
  border-radius 12px
  box-shadow shadow-card

  h3
    margin-top 0
    margin-bottom 20px
    font-size 1.5rem
    color darkRed

.error-messages
  margin-bottom 20px
  padding 15px
  background-color #ffe6e6
  border 1px solid #ffcccc
  border-radius 6px

.error-message
  color #cc0000
  font-size 14px
  margin-bottom 5px
  &:last-child
    margin-bottom 0

.profile-card
  margin 20px 0
  padding 20px
  background whiteColor
  border-radius 12px
  box-shadow shadow-card

.info-row
  display flex
  justify-content space-between
  align-items center
  padding 10px 0
  border-bottom 1px solid borderGray
  &:last-child
    border-bottom none

.info-label
  font-weight bold
  color darkRed

.info-value
  color blackColor

