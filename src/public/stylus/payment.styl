@import 'index'

$pay-radius = 12px
$pay-padding-y = 40px
$pay-padding-x = 30px

body
  background bgMain

.pay-wrapper
  width 90%
  max-width 600px
  margin 120px auto 60px
  background whiteColor
  border-radius $pay-radius
  box-shadow shadow-card
  padding $pay-padding-y $pay-padding-x
  font-family fontRegular

  @media (max-width: bp-tablet)
    margin-top 100px
    padding 30px 20px

.pay-title
  text-align center
  font-size 1.8rem
  color darkRed
  margin-bottom 25px

.pay-form
  display flex
  flex-direction column
  gap 20px

.pay-group
  display flex
  flex-direction column
  gap 8px

.pay-label
  font-weight bold
  font-size 1rem

.pay-btn
  btn()
  width 100%