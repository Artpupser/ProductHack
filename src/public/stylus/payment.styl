@import 'index'

$pay-radius = 12px
$pay-padding-y = 40px
$pay-padding-x = 30px

body
  background bgMain

.pay-wrapper
  width 90%
  max-width 600px
  margin 120px auto 60px
  background whiteColor
  border-radius $pay-radius
  box-shadow shadow-card
  padding $pay-padding-y $pay-padding-x
  font-family fontRegular

  @media (max-width: bp-tablet)
    margin-top 100px
    padding 30px 20px

.pay-title
  text-align center
  font-size 1.8rem
  color darkRed
  margin-bottom 25px

.pay-form
  display flex
  flex-direction column
  gap 20px

.pay-group
  display flex
  flex-direction column
  gap 8px

.pay-label
  font-weight bold
  font-size 1rem

.pay-btn
  btn()
  width 100%
  padding 20px 40px
  font-size 1.3rem
  min-height 70px
  display flex
  align-items center
  justify-content center
  gap 15px
  position relative
  
  &::before
    content ''
    display inline-block
    width 40px
    height 40px
    background-image url('https://yookassa.ru/files/guide/YooKassa-white.svg')
    background-size contain
    background-repeat no-repeat
    background-position center
    flex-shrink 0
  
  &:hover
    transform scale(1.02)
    opacity 1
  
  @media (max-width: bp-mobile)
    font-size 1.1rem
    padding 18px 30px
    min-height 60px
    
    &::before
      width 32px
      height 32px