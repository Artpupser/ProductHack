$auth-bg        = #542121
$auth-card      = #fff
$auth-accent    = #7a1b1b
$auth-border    = #ccc
$auth-radius    = 12px
$auth-shadow    = 0 2px 10px rgba(0,0,0,.08)

body
  background $auth-bg

.auth-wrapper
  width 90%
  max-width 500px
  margin 120px auto 60px
  background $auth-card
  border-radius $auth-radius
  box-shadow $auth-shadow
  padding 40px 30px
  font-family fontRegular

  @media (max-width: 768px)
    margin-top 100px
    padding 30px 20px

.auth-title
  text-align center
  font-size 1.8rem
  color $auth-accent
  margin-bottom 25px

.auth-form
  contact-form()

.auth-form label
  font-weight bold

.auth-form input
  width 100%
  padding 10px
  border 1px solid $auth-border
  border-radius 6px
  font-size 1rem
  margin-bottom 15px
  font-family fontRegular

.auth-form button
  width 100%
  padding 12px
  background $auth-accent
  color #fff
  border none
  border-radius 6px
  cursor pointer
  font-size 1rem
  margin-bottom 10px
  transition background .3s

.auth-form button:hover
  background #a22b2b

.auth-toggle
  text-align center
  color $auth-accent
  cursor pointer
  margin-top 10px