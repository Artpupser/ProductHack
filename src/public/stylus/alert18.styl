font-regular = "bergamosco-regular"

color-main        = #7a1b1b
color-main-hover  = #a22b2b
color-white       = #fff
color-border      = #ccc

shadow-text = 0 2px 4px rgba(0, 0, 0, 0.7)
shadow-card = 0 2px 10px rgba(0, 0, 0, 0.08)

tablet = "(max-width: 768px)"
mobile = "(max-width: 480px)"

flex-center()
  display flex
  align-items center
  justify-content center

card()
  padding 20px
  background color-white
  border-radius 12px
  box-shadow shadow-card

input-base()
  padding 10px
  border 1px solid color-border
  border-radius 6px
  font-size 1rem
  width 100%

.h1-con
  height 100px
  flex-center()
  color color-white
  text-shadow shadow-text
  font-size 3rem
  margin 0

.container_con
  width 90%
  max-width 900px
  margin 40px auto

.section_con
  margin-bottom 40px
  card()

  h2
    margin-top 0
    font-size 1.8rem
    color color-main

.contact-form
  display flex
  flex-direction column
  gap 15px

  label
    font-weight bold

  input,
  textarea
    input-base()

  textarea#message
    resize none

  button
    padding 12px
    background color-main
    color color-white
    border none
    border-radius 6px
    cursor pointer
    font-size 1rem
    transition background 0.3s

    &:hover
      background color-main-hover

@media tablet
  h1
    font-size 2.2rem

@media mobile
  h1
    height 200px
    font-size 1.8rem

  .container_con
    width 95%