@import 'index'

$cart-radius = 12px
$cart-padding-y = 40px
$cart-padding-x = 30px

body
  background bgMain

.cart-wrapper
  width 90%
  max-width 800px
  margin 120px auto 60px
  background whiteColor
  border-radius $cart-radius
  box-shadow shadow-card
  padding $cart-padding-y $cart-padding-x
  font-family fontRegular

  @media (max-width: bp-tablet)
    margin-top 100px
    padding 30px 20px

.cart-title
  text-align center
  font-size 1.8rem
  color darkRed
  margin-bottom 25px

.cart-list
  display flex
  flex-direction column
  gap 15px
  margin-bottom 25px

.cart-item
  display flex
  justify-content space-between
  align-items center
  padding 12px 16px
  border 1px solid borderGray
  border-radius 6px

.cart-item-info
  flex 1

.cart-item-name
  font-weight bold
  margin-bottom 4px

.cart-item-price
  color darkRed

.cart-item-remove
  background transparent
  border none
  color darkRed
  cursor pointer
  font-size 1.2rem
  padding 0 8px
  transition opacity .3s
  &:hover
    opacity .7

.cart-total
  display flex
  justify-content space-between
  align-items center
  font-size 1.4rem
  margin-bottom 25px

.cart-total-label
  font-weight bold

.cart-total-price
  color darkRed

.cart-form
  display flex
  justify-content flex-end

.cart-btn
  btn()
  width 220px

.content_card_prod
  display flex
  gap 20px
  align-items flex-start
  padding 20px
  border 1px solid borderGray
  border-radius 12px
  background whiteColor
  margin-bottom 15px

.wine_card_prod
  width 100px
  height 140px
  object-fit cover
  border-radius 8px
  flex-shrink 0
  box-shadow 0 2px 8px rgba(0,0,0,0.1)

.box_card_prod
  flex 1
  display flex
  flex-direction column
  align-items flex-start  // всё прижато к левому краю
  justify-content center
  gap 6px
  
  h2
    margin 0
    font-size 1.4rem
    color darkRed
    font-weight bold

.wine-info-row
  display flex
  gap 25px           // расстояние между "Тип" и "Регион"
  font-size 1rem
  color blackColor
  
  span
    white-space nowrap

.small-text
  margin 8px 0 0 0
  font-size 0.9rem
  color #666
  line-height 1.5
  font-style italic
  max-width 100%

// Блок управления количеством (справа)
.quantity-control
  display flex
  align-items center
  gap 10px
  margin-left auto      // Прижимает блок к правому краю карточки
  align-self center     // Выравнивает по центру высоты карточки
  padding-left 20px     // Отступ от текста слева

.qty-btn
  width 36px
  height 36px
  border 1px solid borderGray
  background whiteColor
  color darkRed
  border-radius 8px
  font-size 1.4rem
  line-height 1
  cursor pointer
  display flex
  align-items center
  justify-content center
  transition all 0.2s ease
  user-select none
  
  &:hover
    background darkRed
    color whiteColor
    border-color darkRed
  
  &:active
    transform scale(0.95)

.qty-number
  font-size 1.2rem
  font-weight bold
  color blackColor
  min-width 36px
  text-align center
  user-select none