@import 'index'

$cart-radius = 12px
$cart-padding-y = 40px
$cart-padding-x = 30px

body
  background bgMain

.cart-wrapper
  width 90%
  max-width 800px
  margin 120px auto 60px
  background whiteColor
  border-radius $cart-radius
  box-shadow shadow-card
  padding $cart-padding-y $cart-padding-x
  font-family fontRegular

  @media (max-width: bp-tablet)
    margin-top 100px
    padding 30px 20px

.cart-title
  text-align center
  font-size 1.8rem
  color darkRed
  margin-bottom 25px

.cart-list
  display flex
  flex-direction column
  gap 15px
  margin-bottom 25px

.cart-item
  display flex
  justify-content space-between
  align-items center
  padding 12px 16px
  border 1px solid borderGray
  border-radius 6px

.cart-item-info
  flex 1

.cart-item-name
  font-weight bold
  margin-bottom 4px

.cart-item-price
  color darkRed

.cart-item-remove
  background transparent
  border none
  color darkRed
  cursor pointer
  font-size 1.2rem
  padding 0 8px
  transition opacity .3s
  &:hover
    opacity .7

.cart-total
  display flex
  justify-content space-between
  align-items center
  font-size 1.4rem
  margin-bottom 25px

.cart-total-label
  font-weight bold

.cart-total-price
  color darkRed

.cart-form
  display flex
  justify-content flex-end

.cart-btn
  btn()
  width 220px