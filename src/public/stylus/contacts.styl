$overlay-bg = rgba(0, 0, 0, 0.6)
$card-bg = #fff
$radius-lg = 18px
$radius-md = 10px
$shadow-card = 0 20px 50px rgba(0,0,0,.3)
$shadow-hover = 0 6px 16px rgba(0,0,0,.2)
$transition-fast = .15s ease

$green = #34ff89
$red = #ff432e

flex-center()
  display flex
  align-items center
  justify-content center

button-base($bg)
  background $bg
  color #fff
  flex 1
  padding 14px
  border-radius $radius-md
  border none
  font-size 16px
  cursor pointer
  transition transform $transition-fast, box-shadow $transition-fast

  &:hover
    transform translateY(-2px)
    box-shadow $shadow-hover

@keyframes fadeIn
  from
    opacity 0
  to
    opacity 1

@keyframes scaleIn
  from
    transform scale(.9)
    opacity 0
  to
    transform scale(1)
    opacity 1

.age_overlay
  position fixed
  inset 0
  backdrop-filter blur(8px)
  background $overlay-bg
  animation fadeIn .6s ease
  flex-center()

.age_card
  background $card-bg
  padding 40px 32px
  max-width 420px
  width 90%
  border-radius $radius-lg
  text-align center
  box-shadow $shadow-card
  animation scaleIn .5s ease

  h1
    margin 0 0 12px
    font-size 28px

  p
    margin 0 0 28px
    color #555

.buttons
  display flex
  gap 14px

button
  &.yes
    button-base($green)

  &.no
    button-base($red)
