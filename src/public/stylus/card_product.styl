$color-primary = #542121
$color-bg = white
$font-main = 'bergamosco-regular', sans-serif
$font-alt = Alice
$shadow-card = 5px 5px 15px $color-primary
$border-radius-card = 15px

card-shadow()
  box-shadow: $shadow-card
  border-radius: $border-radius-card

flex-center($direction = row, $justify = center, $align = center)
  display: flex
  flex-direction: $direction
  justify-content: $justify
  align-items: $align

.body_product
  background-color: $color-bg
  display: flex
  flex-direction: column
  min-height: 100vh
  margin: 0

.content_card
  flex-center(column, flex-start, center)
  flex: 1
  width: 100%
  padding-left: 8%
  margin-top: 20px
  padding-top: 6%

  .wine_card
    width: 400px
    height: 400px
    object-fit: cover
    card-shadow()
    margin-right: 20px

  .box_card
    card-shadow()
    display: flex
    flex-direction: column
    padding: 20px
    background-color: $color-bg
    height: 400px
    width: 50%
    font-size: 40px
    color: $color-primary
    overflow-y: auto
    font-family: $font-main

    .small-text
      color: $color-primary
      font-size: 20px
      margin-top: 10px
      font-family: $font-alt
